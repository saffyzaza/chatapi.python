# ── AI Keys ───────────────────────────────────────────────────────────────────
# ⚠️ ห้าม commit ค่าจริงลงใน .env — copy ไฟล์นี้เป็น .env และกรอกค่าจริง
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
TAVILY_API_KEY=your-tavily-api-key-here

# ── Gemini Models ─────────────────────────────────────────────────────────────
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_MODEL_PRO=gemini-2.5-pro
REPORT_MAX_TOKENS=8192
GEMINI_RETRY_LIMIT=3
GEMINI_RETRY_DELAY=60

# ── CrewAI / Tracing ──────────────────────────────────────────────────────────
CREWAI_TRACING_ENABLED=false
OTEL_SDK_DISABLED=true

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=musyadata
DB_USER=postgres
DB_PASSWORD=your-strong-db-password-here

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_USE_SSL=false
MINIO_BUCKET=fileapa

# ── Obsidian Knowledge Vault ──────────────────────────────────────────────────
OBSIDIAN_VAULT_PATH=src/obsidian_knowledge
OBSIDIAN_DEFAULT_VAULT=health_region_10
OBSIDIAN_ENABLED=true
OBSIDIAN_SEARCH_THRESHOLD=0.1
OBSIDIAN_RAW_PDF_PATH=obsidian_raw_pdf
OBSIDIAN_PDF_MINIO_PREFIX=obsidian-pdfs

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ── CORS — อนุญาต Next.js frontend ───────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Internal API Key ──────────────────────────────────────────────────────────
# สร้างด้วย: python -c "import secrets; print(secrets.token_hex(32))"
# ต้องตรงกับ INTERNAL_API_KEY ใน chatappandpython/.env.local
INTERNAL_API_KEY=generate-with-secrets-token-hex-32
